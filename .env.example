# Watchening settings. Copy this file to .env (same folder), change what you
# need, then run:  docker compose up -d
# Everything here is optional; the defaults run at http://localhost:8080.
# Secrets and the first admin password are made for you on the first start.

# The address people type to open the site, without a path. On a server
# behind https (Traefik, Caddy, Cloudflare...) that's the https address:
#   PUBLIC_URL=https://tv.example.com
# At home over plain http, the address your TV uses, such as:
#   PUBLIC_URL=http://192.168.1.20:8080
PUBLIC_URL=http://localhost:8080

# The port on this machine the site is published on. Behind a reverse proxy
# on the same machine, publish it to this machine only, so nobody can go
# around the proxy:  WEBUI_PORT=127.0.0.1:8080
WEBUI_PORT=8080

# Sign-in. "on" (default): everyone needs an account. "off": no sign-in, and
# the site only answers devices on your home network. Use "off" only if the
# site can't be reached from the internet (no port forwarding, no tunnel).
AUTH=on

# Guide builder for zlive's channels. No site is set out of the box: put
# the same address you typed into Settings, Playlists, "zlive Channels"
# here to build guide listings for them. Left empty, the builder does nothing.
ZLIVE_URL=
EPG_DAYS=3           # days of listings to fetch
EPG_EVERY_HOURS=12    # hours between rebuilds
EPG_MAX_CONNECTIONS=5

# Stream proxy worker processes. More helps with many viewers at once.
MEDIAFLOW_WORKERS=2

# Voice search (the on-screen keyboard's Voice key), run on this server's CPU
# with one of FUTO's voice input models (https://keyboard.futo.tech/voice-input-models):
#   english-39    fastest, and plenty for names and titles (default)
#   english-74    a little more accurate, about twice the work
#   english-244   most accurate, much slower on a CPU
#   multilingual-39 / -74 / -244   other languages (set SPEECH_LANGUAGE to one,
#                 such as de, or leave it empty to work it out)
# A model is downloaded the first time it's used. Voice search only works on
# an https:// address (or http://localhost on the server itself).
SPEECH_MODEL=english-39
SPEECH_THREADS=4      # CPU threads for each clip
SPEECH_LANGUAGE=

# On Demand from Stremio addons and a debrid service, through AIOStreams
# (https://github.com/Viren070/AIOStreams). Its setup page, where you pick
# the addons (Cinemeta for the catalogs, and stream addons such as Torrentio
# or Comet) and the debrid service, is on this machine only:
#   http://localhost:3001/stremio/configure   (sign-in: data/aiostreams-login.txt)
# To open it from another computer at home, publish it there instead, such
# as AIOSTREAMS_PORT=3001. Never put it on the internet.
AIOSTREAMS_PORT=127.0.0.1:3001
# Optional: your debrid service's API key, filled in for you on that page.
# One of realdebrid, alldebrid, premiumize, debridlink, torbox, easydebrid,
# debrider. Every stream is relayed through this server, so the service only
# ever sees one address, however many people watch.
DEBRID_SERVICE=realdebrid
DEBRID_API_KEY=
