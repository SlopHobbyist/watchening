{
  "$id": "https://watchening.local/schemas/user.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "title": "Username",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "ory.sh/kratos": {
            "credentials": { "password": { "identifier": true } }
          }
        },
        "name": {
          "type": "string",
          "title": "Name",
          "maxLength": 64
        }
      },
      "required": ["username"],
      "additionalProperties": false
    }
  }
}
